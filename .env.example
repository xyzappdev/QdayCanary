# Copy to .env.local for local development.

# Required. The build fails without them. The CA below is a placeholder (the System Program
# address); production builds refuse it.
TOKEN_CA=11111111111111111111111111111111
TOKEN_TICKER=TICKER

# Team wallet: a normal wallet with a key, creator of the coin and receiver of its creator fees.
# Required on production. Without it locally, Fees waiting shows a dash and the Creator line is hidden.
TEAM_WALLET=

# Solana RPC. The public endpoint works but serves about one getTransaction a second.
SOLANA_RPC_URL=

# Optional: Global Config (formerly Edge Config) keeps death_tx, alive_since and balance_checkpoint.
# GLOBAL_CONFIG is set automatically when you connect a store to the project.
# GLOBAL_CONFIG=
# EDGE_CONFIG=  (legacy name, also read)

# Optional: writes to Global Config through the Vercel REST API.
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
